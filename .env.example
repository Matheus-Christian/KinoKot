# =========================================================================
# KINOKOTT (КИНОКОТ) - ENVIRONMENT CONFIGURATION
# =========================================================================

# Supabase Project URL (Encontre em Project Settings > API no Supabase Dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Encontre em Project Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...sua-chave-anon-aqui

# Opcional: OMDb API Key para busca ao vivo no catálogo IMDb (omdbapi.com)
# Caso não preenchido, o app utiliza o acervo curado com dezenas de clássicos soviéticos e mundiais
VITE_OMDB_API_KEY=
